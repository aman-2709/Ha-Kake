# VehicleTap dashboard + simulator under systemd, as a Podman Quadlet unit.
# Install and view it: docs/CONTAINER.md
#   sudo cp vehicletap.container vehicletap.volume /etc/containers/systemd/
#   sudo systemctl daemon-reload && sudo systemctl start vehicletap
[Unit]
Description=VehicleTap dashboard (simulator)

[Container]
Image=localhost/vehicletap:latest
ContainerName=vehicletap
# Host networking is required: the dashboard (127.0.0.1:5000) and the
# simulator's control API (127.0.0.1:8099) bind loopback only, and a published
# port cannot reach a container's own loopback. Nothing is exposed to the LAN.
Network=host
Volume=vehicletap.volume:/data
Environment=VEHICLETAP_DATA_DIR=/data
Exec=python web/app.py --adapter sim
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5
# On SIGTERM the app exits 128+15 (web/app.py _shutdown): that is a clean stop.
SuccessExitStatus=143

# Rootful, as shipped. For a rootless install (~/.config/containers/systemd/,
# systemctl --user) use WantedBy=default.target: a user manager has no
# multi-user.target, so this line would never start the unit at boot.
[Install]
WantedBy=multi-user.target
